+// Ask Gemini to return a JSON transcript with start/end times per segment.
+async function requestTranscriptSegments(
+  parts: Array<Record<string, unknown>>,
+  opts: { targetSegmentSeconds?: number } = {},
+): Promise<TranscriptResult> {
+  const target = Math.max(3, Math.min(20, opts.targetSegmentSeconds ?? 8));
+
+  const response = await geminiRequest(
+    `/${MODEL_NAME}:generateContent`,
+    {
+      method: "POST",
+      body: JSON.stringify({
+        contents: [
+          {
+            role: "user",
+            parts: [
+              {
+                text:
+                  `Transcribe this media from a garden walkthrough. ` +
+                  `Return strictly JSON with the shape {\n  \"fullText\": string,\n  \"segments\": [ { \"start_s\": number, \"end_s\": number, \"text\": string } ]\n}. ` +
+                  `Use seconds from 0. Segment phrases using natural pauses; aim for ${target}s per segment. ` +
+                  `Do not include any commentary or additional fields.`,
+              },
+              ...parts.filter((p) => "fileData" in p || "inlineData" in p),
+            ],
+          },
+        ],
+        generationConfig: { response_mime_type: "application/json" },
+      }),
+    },
+    "Gemini timestamped transcription failed",
+  );
+
+  const json = (await response.json()) as GeminiGenerateResponse;
+  const payloadStr = extractTranscript(json);
+  try {
+    const parsed = JSON.parse(payloadStr) as TranscriptResult;
+    if (!parsed || !Array.isArray(parsed.segments)) {
+      throw new Error("Unexpected JSON structure from Gemini.");
+    }
+    return parsed;
+  } catch (e) {
+    throw new Error(`Unable to parse timestamped transcript JSON: ${(e as Error).message}`);
+  }
+}
